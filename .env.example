# ==============================================================================
# AI Quant Agent Environment Variables Template
# Broker-Agnostic & Fully Autonomous US Equities Quantitative Trading Platform
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to any public or private git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Reasoning Engine (OpenAI-compatible protocol)
# Supports: OpenAI (GPT-4o), Perplexity (Sonar), Mindlogic FactChat, Ollama, vLLM
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. Telemetry & Alerting (Telegram Bot API)
# ------------------------------------------------------------------------------
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 3. Pluggable Broker Driver Configuration (Optional for MockBroker simulation)
# Driver: Toss Securities US Equities OpenAPI Adapter (BaseBroker implementation)
# Leave empty to automatically fallback to MockBroker for zero-credential paper trading
# ------------------------------------------------------------------------------
TOSS_APP_KEY=your_toss_app_key_here
TOSS_APP_SECRET=your_toss_app_secret_here
TOSS_ACCOUNT_NO=your_toss_account_no_or_account_seq

# ------------------------------------------------------------------------------
# 4. Mobile & Desktop Web Dashboard Configuration
# ------------------------------------------------------------------------------
DASHBOARD_TOKEN=generate_a_secure_random_token_here
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899
DASHBOARD_PUBLIC_URL=https://your-domain.duckdns.org

# ------------------------------------------------------------------------------
# 5. Quantitative Strategy & Execution Modes
# STRATEGY_MODE: breakout (Nanocap Snowball) | rotation (Sector ETF) | paper
# AI_MODE: deep (Deep Pro SEC Audit) | standard | lite | off (Zero-cost pure quant)
# ROTATION_DRY_RUN: true (simulated execution) | false (live broker execution)
# ------------------------------------------------------------------------------
STRATEGY_MODE=breakout
AI_MODE=deep
ROTATION_DRY_RUN=true
ROTATION_CAPITAL_CAP_USD=1000
