# ==============================================================================
# AI Quant Agent Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to any public or private git repository.
# ==============================================================================

# LLM Configuration (OpenAI-compatible endpoint, e.g., OpenAI, Perplexity, DeepSeek, Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# Telegram Notification Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Toss Securities OpenAPI (Korea / US Stock Brokerage)
TOSS_APP_KEY=your_toss_app_key_here
TOSS_APP_SECRET=your_toss_app_secret_here
TOSS_ACCOUNT_NO=your_toss_account_no_or_account_seq

# Upbit API (Optional for Crypto multi-exchange)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# CME / LS Securities (Optional for Futures MNQZ26)
LS_APP_KEY=your_ls_app_key_here
LS_APP_SECRET=your_ls_app_secret_here

# Web Dashboard Configuration
DASHBOARD_TOKEN=generate_a_secure_random_token_here
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899

# Strategy & Risk Mode
STRATEGY_MODE=paper              # rotation | paper | live
ROTATION_DRY_RUN=true            # true: simulate orders, false: execute live
ROTATION_CAPITAL_CAP_USD=1000    # Maximum allocation budget in USD
